@IsTest
private class AutomationChain_Test {
    // The chained generation: the Flow action (documentAutomationController) makes the document and queues sendEmailAutomation, which
    // saves the PDF on the record and then calls the class named in the custom metadata record DXTemplates_HandlerClass "HandlerClass".

    private static Id makeTemplate(String name) {
        Document_Template__c template = new Document_Template__c(Name = name, Related_To_Type__c = 'Account');
        insert template;
        insert new Document_Template_Section__c(Name = 'Letter', Document_Template__c = template.Id, Type__c = 'Context', Sequence__c = 0, Section_Content__c = '<p>Letter for {!Account.NumberOfEmployees}</p>');
        return template.Id;
    }

    private static void run(Id templateId, Id recordId) {
        documentAutomationController.recordParameters parameters = new documentAutomationController.recordParameters();
        parameters.recordId = recordId;
        parameters.templateId = templateId;
        parameters.documentName = 'Chained';
        parameters.docOrientation = 'Portrait';
        parameters.docSize = 'A4';
        parameters.multiplePdf = false;
        Test.startTest();
        documentAutomationController.autoGenerateDocumentRecord(new List<documentAutomationController.recordParameters>{ parameters });
        Test.stopTest();
    }

    @IsTest
    static void thePdfIsSavedOnTheRecordAndTheHandlerReceivesWhatWasGenerated() {
        Account account = new Account(Name = 'Acme');
        insert account;
        sendEmailAutomation.handlerClassNameForTest = 'PlaceholderTestHandler';

        run(makeTemplate('Chained'), account.Id);

        List<Attachment> attachments = [SELECT Id, Name FROM Attachment WHERE ParentId = :account.Id];
        System.assertEquals(1, attachments.size(), 'the PDF is saved on the record');
        System.assertEquals('Chained.pdf', attachments[0].Name);
        System.assertNotEquals(null, PlaceholderTestHandler.lastInput, 'the handler class was called with something');
        System.assertEquals(String.valueOf(account.Id), String.valueOf(PlaceholderTestHandler.lastInput.get('recordId')));
        System.assertEquals(String.valueOf(attachments[0].Id), String.valueOf(PlaceholderTestHandler.lastInput.get('attachmentId')));
        System.assertNotEquals(null, PlaceholderTestHandler.lastInput.get('documentId'));
    }

    // A Related Objects section made outside the designer (import, API, seed) has no saved header row (Header_Content__c); the
    // run used to stop with a null error and no document.
    @IsTest
    static void aRelatedObjectsSectionMadeOutsideTheDesignerStillGivesThePdf() {
        Account account = new Account(Name = 'Acme');
        insert account;
        insert new Opportunity(AccountId = account.Id, Name = 'Deal 1', StageName = 'Prospecting', CloseDate = Date.today().addDays(5), Amount = 100);
        Id templateId = makeTemplate('RO without header');
        insert new Document_Template_Section__c(Name = 'Deals', Document_Template__c = templateId, Type__c = 'Related Objects', Sequence__c = 1,
            Section_Content__c = '{"whereClause":"()","mainChildObject":"Opportunity","childLookupfieldAPIname":"AccountId","mainparentObject":"","SerialNumber":false,"subTotal":[],"newPage":false,"displayChart":false,"tablelistValues":["Name","Amount","Account.NumberOfEmployees"],"tablelistLabels":["Name","Amount","Account"],"grouping":"","dateFormat":"654/*","timeFormat":"124","numberFormat":"2","currencyFormat":"2"}');
        sendEmailAutomation.handlerClassNameForTest = 'PlaceholderTestHandler';

        run(templateId, account.Id);

        System.assertEquals(1, [SELECT COUNT() FROM Attachment WHERE ParentId = :account.Id], 'the PDF is saved on the record');
        System.assertEquals(0, [SELECT COUNT() FROM TransactionLog__c WHERE LogType__c = 'Exception']);
    }

    @IsTest
    static void aHandlerClassThatDoesNotExistDoesNotSpoilTheRun() {
        Account account = new Account(Name = 'Acme');
        insert account;
        sendEmailAutomation.handlerClassNameForTest = 'NoSuchHandlerClass';

        run(makeTemplate('Missing handler'), account.Id);

        System.assertEquals(1, [SELECT COUNT() FROM Attachment WHERE ParentId = :account.Id], 'the PDF is saved all the same');
        System.assertEquals(0, [SELECT COUNT() FROM TransactionLog__c WHERE LogType__c = 'Exception' AND Process_Name__c LIKE 'sendEmailAutomation%']);
    }

    @IsTest
    static void aPageOrientationWrittenAsPotraitIsPortrait() {
        Document_Template__c template = new Document_Template__c(Name = 'Orientation', Related_To_Type__c = 'Account');
        insert template;
        Document__c document = new Document__c(Document_Template__c = template.Id, Document_Body__c = '<p>x</p>', Sequence__c = 0);
        insert document;
        Test.setCurrentPage(Page.renderAsPdfLWC);
        ApexPages.currentPage().getParameters().put('documentid', document.Id);
        ApexPages.currentPage().getParameters().put('selectedPageSize', 'Letter');
        ApexPages.currentPage().getParameters().put('selectedPageOrientation', 'Potrait');

        DisplayPDFController controller = new DisplayPDFController();

        System.assertEquals('Letter Portrait', DisplayPDFController.selectedSize, 'the misspelled word the Flow action asks for is understood');
        System.assertEquals(false, DisplayPDFController.isLandscape);
    }

    @IsTest
    static void anUnknownPageSizeFallsBackToA4() {
        Document_Template__c template = new Document_Template__c(Name = 'Size', Related_To_Type__c = 'Account');
        insert template;
        Document__c document = new Document__c(Document_Template__c = template.Id, Document_Body__c = '<p>x</p>', Sequence__c = 0);
        insert document;
        Test.setCurrentPage(Page.renderAsPdfLWC);
        ApexPages.currentPage().getParameters().put('documentid', document.Id);
        ApexPages.currentPage().getParameters().put('selectedPageSize', 'Foolscap');
        ApexPages.currentPage().getParameters().put('selectedPageOrientation', 'Landscape');

        DisplayPDFController controller = new DisplayPDFController();

        System.assertEquals('A4 Landscape', DisplayPDFController.selectedSize);
        System.assertEquals(true, DisplayPDFController.isLandscape);
    }
}
