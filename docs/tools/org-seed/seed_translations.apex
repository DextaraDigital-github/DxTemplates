    rows.add(new DxCPQ__Translator__c(Name = 'Paragraph', DxCPQ__FieldValue__c = 'Paragraph', DxCPQ__Translated_Value__c = 'Este acuerdo describe c\u00f3mo tratamos sus datos, sus pedidos y sus pagos. Si un art\u00edculo llega da\u00f1ado (o no coincide con la descripci\u00f3n), av\u00edsenos en un plazo de 30 d\u00edas y lo repararemos, lo sustituiremos o le devolveremos el precio completo, lo que usted prefiera. \u00bfPreguntas sobre este texto? Escriba a la direcci\u00f3n de la primera p\u00e1gina indicando el n\u00famero de este documento.', DxCPQ__Language__c = 'es', DxCPQ__DocumentTemplate__c = tmpl.Id));
